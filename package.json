{
  "name": "blox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @blox/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @blox/web preview",
    "deploy": "pnpm --filter @blox/web build && wrangler deploy",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "catalog:"
  }
}
